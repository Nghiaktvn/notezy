# Notezy .htaccess
# Protects sensitive files from direct web access
Options -Indexes

# Runtime state, Git metadata and initialization SQL are not public assets.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
    RewriteRule ^(?:storage|config|includes|scripts|services)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(\.(sql|sqlite|sqlite3|log|bak)$|^\.env(?:\..*)?$|^Dockerfile(?:\..*)?$|^docker-compose.*\.ya?ml$)">
    Require all denied
</FilesMatch>

# ── Block Python AI agent source ──────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ai_agent/ - [F,L]
</IfModule>
<FilesMatch "\.(py|pyc|pyo)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block dev/test scripts (seed accounts, DB probes) from web access ─────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(tests/|test_[^/]*\.php$) - [F,L]
</IfModule>

# ── Block .env file ───────────────────────────────────────────────────────
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# ── Block config directory ────────────────────────────────────────────────
<FilesMatch "^(database\.php|\.gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block PHP execution in uploads/ ──────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|php3|php4|php5|phtml|pl|py|cgi|sh)$ - [F,L]
</IfModule>

# ── PHP settings ──────────────────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
</IfModule>
