# ── Secrets — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── PHP / vendor ─────────────────────────────────────────────────────────
vendor/
composer.lock

# ── Frontend build artifacts ────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dev-dist/
node_modules/

# ── User-uploaded content (not source, and may contain private data) ─────
uploads/*
!uploads/.htaccess

# ── Logs / OS / editor cruft ──────────────────────────────────────────────
*.log
storage/sessions/
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── AI agent local state ──────────────────────────────────────────────────
**/__pycache__/
*.pyc
ai_agent/.pytest_cache/
