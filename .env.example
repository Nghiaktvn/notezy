APP_ENV=local
APP_URL=http://localhost:8080
# Codespaces derives these URLs in .devcontainer/initialize.sh. Configure mail
# and LLM credentials as GitHub Codespaces secrets, never in the repository.
COLLAB_WS_PUBLIC_URL=ws://localhost:8766
APP_TIMEZONE=Asia/Ho_Chi_Minh
JWT_SECRET=replace_with_a_long_random_value

REDIS_HOST=redis
REDIS_PORT=6379
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_OWNER=

DB_HOST=db
DB_PORT=3306
DB_NAME=notezy
DB_USER=root
DB_PASSWORD=change_me_for_local_docker
# Managed MySQL: require TLS and mount the provider CA as a private file.
DB_SSL_REQUIRED=false
DB_SSL_CA=
# Use a different value from DB_PASSWORD in production. This password is
# granted only to the individual microservice database accounts.
SERVICE_DB_PASSWORD=change_me_for_service_accounts

# Local/Codespaces: smtp. Render Free: gmail_api (your Gmail sender) or resend.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=trungnghia282006@gmail.com
MAIL_PASSWORD=replace_with_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sender@example.com
MAIL_FROM_NAME="Notezy"
# Gmail API on Render Free: create an OAuth client and authorize this Gmail
# account for the gmail.send scope with offline access. Keep these in Render
# Environment only; do not commit real credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# For MAIL_MAILER=resend, add a Resend API key and use an address on a
# verified sending domain. The Gmail SMTP app password is not an API key.
RESEND_API_KEY=
# Keep user-facing OTP requests responsive if the SMTP host is unreachable.
MAIL_TIMEOUT_SECONDS=10
MAIL_TIMELIMIT_SECONDS=15

AI_AGENT_URL=http://ai_agent:8765
AI_AGENT_SHARED_SECRET=change_me_to_a_long_random_string
AI_AGENT_TIMEOUT_SECONDS=30

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
