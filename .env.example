APP_ENV=local
APP_URL=http://localhost:8080
# Codespaces derives these URLs in .devcontainer/initialize.sh. Configure mail
# and LLM credentials as GitHub Codespaces secrets, never in the repository.
COLLAB_WS_PUBLIC_URL=ws://localhost:8766
APP_TIMEZONE=Asia/Ho_Chi_Minh
JWT_SECRET=replace_with_a_long_random_value

REDIS_HOST=redis
REDIS_PORT=6379
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=

DB_HOST=db
DB_PORT=3306
DB_NAME=notezy
DB_USER=root
DB_PASSWORD=change_me_for_local_docker
# Use a different value from DB_PASSWORD in production. This password is
# granted only to the individual microservice database accounts.
SERVICE_DB_PASSWORD=change_me_for_service_accounts

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=trungnghia282006@gmail.com
MAIL_PASSWORD=replace_with_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=trungnghia282006@gmail.com
MAIL_FROM_NAME="Notezy"

AI_AGENT_URL=http://ai_agent:8765
AI_AGENT_SHARED_SECRET=change_me_to_a_long_random_string

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
