# Notezy local/Docker configuration template. Copy this file to .env and replace placeholders.
APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Host ports. Change these when another Notezy stack is already running.
WEB_PORT=8080
DB_HOST_PORT=3307
PHPMYADMIN_PORT=8081
AI_AGENT_HOST_PORT=8765
COLLAB_WS_HOST_PORT=8766

# Generate unique values for any deployed environment; never commit real values.
JWT_SECRET=replace_with_a_long_random_secret
AI_AGENT_SHARED_SECRET=replace_with_a_long_random_secret

DB_HOST=db
DB_PORT=3306
DB_NAME=notezy
DB_USER=root
DB_PASSWORD=replace_with_a_strong_local_db_password
SERVICE_DB_PASSWORD=replace_with_a_different_service_db_password

REDIS_HOST=redis
REDIS_PORT=6379

# Gmail requires a valid App Password and two-step verification. Leave empty to disable SMTP locally.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Notezy

# AI uses Gemini when a key is supplied. gemini-3.5-flash is a stable, low-latency default.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
AI_AGENT_URL=http://ai_agent:8765

# Optional integrations
COLLAB_WS_PUBLIC_URL=ws://localhost:8766
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
