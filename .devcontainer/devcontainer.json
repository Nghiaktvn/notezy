{
  "name": "Notezy Full Stack",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.services.yml"
  ],
  "service": "web",
  "workspaceFolder": "/var/www/html",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "runServices": [
    "db",
    "redis",
    "db_provisioner",
    "ai_agent",
    "collab_ws",
    "web",
    "auth_service",
    "user_service",
    "note_service",
    "file_service",
    "ai_service",
    "premium_service",
    "collaboration_service",
    "outbox_worker",
    "gateway"
  ],
  "forwardPorts": [80, 8765, 8766, 8088],
  "portsAttributes": {
    "80": { "label": "Notezy Web", "onAutoForward": "openBrowser" },
    "8765": { "label": "Notezy AI health", "onAutoForward": "silent" },
    "8766": { "label": "Notezy realtime WebSocket", "onAutoForward": "notify" },
    "8088": { "label": "Notezy API gateway", "onAutoForward": "silent" }
  },
  "remoteUser": "root"
}
