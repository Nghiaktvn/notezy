# Public project metadata (safe for browser clients).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only PostgreSQL connection. Never commit the real password.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_with_your_supabase_database_password

# Optional server-only Data API access. Never expose this key in JavaScript.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_service_role_key
